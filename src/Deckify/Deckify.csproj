    <!--
      UpdateHelper is a separate signed EXE invoked by the add-in to restart
      PowerPoint after an update (we can't kill our own host and then relaunch
      it from inside it). ReferenceOutputAssembly=false means MSBuild treats it
      as a build dependency only — not a managed reference. The None Include
      below copies the built EXE next to Deckify.dll so the add-in can locate
      it via Path.GetDirectoryName(Assembly.Location).
    -->
    <ProjectReference Include="..\Deckify.UpdateHelper\Deckify.UpdateHelper.csproj">
      <Name>Deckify.UpdateHelper</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <!--
      Content (not None) so MSBuild's GenerateApplicationManifest target picks it
      up as a "data file" in the ClickOnce manifest. With None Include it copied
      to bin/ correctly but ClickOnce skipped it on publish (manifest only had
      Compile + Content items). The helper is built first via the ProjectReference
      above, so by the time this Content item is evaluated for copy, the .exe
      exists. Post-build signing of the helper happens before this copy too, so
      signed bytes end up in bin/ and the ClickOnce manifest hashes those.
    -->
    <Content Include="..\Deckify.UpdateHelper\bin\$(Configuration)\net48\Deckify.UpdateHelper.exe">
      <Link>Deckify.UpdateHelper.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

