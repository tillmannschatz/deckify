{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/scripts/build.ps1"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/scripts/build.ps1",
                "-Configuration", "Release"
            ],
            "problemMatcher": "$msCompile",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/scripts/test.ps1"
            ],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Register Debug Manifest",
            "detail": "Register PPTXML\\bin\\Debug\\PPTXML.vsto with PowerPoint via HKCU registry. Run after first build.",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/debug_setup.ps1"
            ],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Unregister Debug Manifest",
            "detail": "Remove the HKCU registry entry that points PowerPoint at the local debug build.",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/scripts/unregister-debug.ps1"
            ],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Launch PowerPoint",
            "detail": "Start PowerPoint so the registered debug add-in loads. Close PowerPoint before rebuilding.",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command", "Start-Process powerpnt"
            ],
            "problemMatcher": [],
            "presentation": { "reveal": "silent", "panel": "shared" }
        }
    ]
}
